@page "/dashboard"
@rendermode InteractiveServer

@using EmployeeLeavePortal.Data
@using EmployeeLeavePortal.Models
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db

<PageTitle>Employee Dashboard</PageTitle>

<h1>Employee Dashboard</h1>

@if (employee == null)
{
    <p>Loading employee...</p>
}
else
{
    <h2 class="mb-4">Welcome, @employee.Name</h2>

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Employee Information</h5>

                    <p class="card-text mb-1">
                        <strong>Name:</strong> @employee.Name
                    </p>

                    <p class="card-text">
                        <strong>Email:</strong> @employee.Email
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Vacation Balance</h5>

                    <p class="display-6 mb-0">
                        @employee.VacationDays
                    </p>

                    <p class="text-muted">
                        days available
                    </p>
                </div>
            </div>
        </div>
    </div>

    <a class="btn btn-primary mb-4" href="/request-leave">
        Request Leave
    </a>

    <h3>My Leave Requests</h3>

    @if (leaveRequests.Count == 0)
    {
        <p>You haven't submitted any leave requests yet.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Comment</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var request in leaveRequests)
                {
                    <tr>
                        <td>@request.Type</td>
                        <td>@request.StartDate.ToString("dd.MM.yyyy")</td>
                        <td>@request.EndDate.ToString("dd.MM.yyyy")</td>
                        <td>@request.Comment</td>
                        <td>@request.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private Employee? employee;

    private List<LeaveRequest> leaveRequests = [];

    protected override async Task OnInitializedAsync()
    {
        employee = await Db.Employees.FirstOrDefaultAsync();

        if (employee != null)
        {
            leaveRequests = await Db.LeaveRequests
                .Where(request => request.EmployeeId == employee.Id)
                .OrderByDescending(request => request.StartDate)
                .ToListAsync();
        }
    }
}